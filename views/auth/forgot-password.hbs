<main>
  <div class="login-container">
    <h1>Forgot Password</h1>
    <p class="utility-copy">Enter the email address tied to your account and we will prepare a secure one-time password reset link.</p>

    {{#if success}}
      <div class="success-box">{{success}}</div>
    {{/if}}

    {{#if error}}
      <div class="error-message">{{error}}</div>
    {{/if}}

    {{#if resetUrl}}
      <div class="success-box">
        Demo mode is enabled for password resets. Use this one-time link now:
        <a class="inline-link" href="{{resetUrl}}">{{resetUrl}}</a>
      </div>
    {{/if}}

    <form method="POST" action="/auth/forgot-password">
      <div class="form-group">
        <label for="forgotPasswordEmail">Account Email</label>
        <input
          id="forgotPasswordEmail"
          name="email"
          type="email"
          value="{{formData.email}}"
          maxlength="120"
          required
        >
      </div>
      <button type="submit" class="login-button">Generate Reset Link</button>
    </form>

    <div class="signup-link">
      Remembered your password? <a href="/login">Back to login</a>
    </div>
  </div>
</main>
