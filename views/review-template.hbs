<main class="restaurant-page">
  <section class="top-hero">
    <div class="page-container hero-row hero-row-single">
      <div class="hero-text">
        <h1>{{restaurant.name}}</h1>
        <p class="sub">{{restaurant.location}} • {{restaurant.priceRange}} • {{restaurant.reviewCount}} reviews</p>
      </div>
    </div>
  </section>

  <section class="restaurant-header page-container">
    <div class="restaurant-logo">
      <img src="{{restaurant.imageSrc}}" alt="{{restaurant.name}}">
    </div>
      <div class="card-body restaurant-details">
        <h3 class="title">{{restaurant.name}}</h3>
        <p class="meta">
          {{restaurant.location}} <br>
          {{restaurant.priceRange}} • ★ {{restaurant.rating}}
        </p>
        {{#if hasOwner}}
          <p class="owner-chip">Managed by <a class="inline-link" href="/profile/{{owner.username}}">{{owner.username}}</a></p>
        {{else}}
          <p class="owner-chip owner-chip-open">No owner account assigned yet.</p>
        {{/if}}
        <div class="cuisine-list">
          {{#each restaurant.cuisineTypes}}
            <span class="cuisine-btn">{{this}}</span>
        {{/each}}
      </div>
      <p class="excerpt">{{restaurant.previewDescription}}</p>
    </div>
  </section>

  <section class="restaurant-review-layout page-container">
    <aside class="review-form-panel">
      {{#if currentUser}}
        <section class="login-container review-form-card">
          <h1>Add a Review</h1>
          <!-- in review-template.hbs Add enctype and file inputs -->
          <form method="POST" action="/reviews" enctype="multipart/form-data" class="review-post-form">
            <input type="hidden" name="restaurantId" value="{{restaurant.restaurantId}}">

            <div class="form-group">
              <label for="reviewTitle">Title</label>
              <input id="reviewTitle" name="title" type="text" required />
            </div>

            <div class="form-group">
              <label for="reviewRating">Rating</label>
              <select id="reviewRating" name="rating" required>
                <option value="5">5</option>
                <option value="4">4</option>
                <option value="3">3</option>
                <option value="2">2</option>
                <option value="1">1</option>
              </select>
            </div>

            <div class="form-group">
              <label for="reviewBody">Review</label>
              <textarea id="reviewBody" name="body" rows="5" required></textarea>
            </div>

            <!-- Icon buttons for media -->
            <div class="form-group media-controls">
              <!-- Hidden file inputs -->
              <input id="inputImages" name="images" type="file" accept="image/*" multiple class="visually-hidden">
              <input id="inputVideo" name="video" type="file" accept="video/*" class="visually-hidden">

              <!-- Icon buttons (labels) -->
              <label for="inputImages" class="media-icon-btn" title="Attach images (max 3)">
                <!-- simple inline SVG icon for image -->
                <svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="currentColor" d="M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14h18zM8.5 11.5l2.5 3 3.5-4.5L19 17H5l3.5-5.5z"/>
                </svg>
                <span class="media-label">Image</span>
              </label>

              <label for="inputVideo" class="media-icon-btn" title="Attach a video">
                <!-- simple inline SVG icon for video -->
                <svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path fill="currentColor" d="M17 10.5V7c0-1.1-.9-2-2-2H5C3.9 5 3 5.9 3 7v10c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-3.5l4 4v-11l-4 4z"/>
                </svg>
                <span class="media-label">Video</span>
              </label>

              <!-- small preview area -->
              <div class="media-preview" aria-live="polite">
                <span class="media-help">Optional: attach images or a video</span>
                <div class="media-files"></div>
              </div>
            </div>

            <button type="submit" class="register-button">Post Review</button>
          </form>


        </section>
      {{else}}
        <section class="review-form-card guest-review-card">
          <h2>Add a Review</h2>
          <p class="utility-copy">Login first to post your own review and vote on other comments.</p>
          <a class="button-link" href="/login">Login to Review</a>
        </section>
      {{/if}}

      <section class="review-form-card owner-request-card">
        <h2>Owner Access</h2>
        {{#if isOwnerForRestaurant}}
          <p class="utility-copy">You can respond publicly to reviews for this restaurant below.</p>
        {{else}}
          {{#if isAdminUser}}
            <p class="utility-copy">Assign restaurant owners from the admin dashboard.</p>
            <a class="button-link secondary-button" href="/admin">Open Admin Dashboard</a>
          {{else}}
            {{#if canRequestOwnership}}
              {{#if currentUser}}
                <p class="utility-copy">Own this place? Send your contact details to admin and we can tag your account as the restaurant owner.</p>
                <a class="button-link secondary-button" href="/admin-support?restaurantId={{restaurant.restaurantId}}">Are You the Owner?</a>
              {{else}}
                <p class="utility-copy">Own this place? Register first and include your owner details so admin can review the request.</p>
                <a class="button-link secondary-button" href="/register?ownerRequest=1&restaurantId={{restaurant.restaurantId}}">Register as Owner</a>
              {{/if}}
            {{else}}
              <p class="utility-copy">This restaurant already has an assigned owner account.</p>
            {{/if}}
          {{/if}}
        {{/if}}
      </section>
    </aside>

    <section class="review-feed">
      <h2>Reviews</h2>
      {{#if hasReviews}}
        {{#each reviews}}
          <article class="review-card" data-review-id="{{this._id}}">
            <div class="review-profile">
              <img class="profile-pic" src="{{this.author.profilePic}}" alt="{{this.author.username}} profile picture"
                onerror="this.onerror=null;this.src='/img/default_profile.png';">
              <div class="review-meta">
                <p class="username"><a class="inline-link" href="{{this.authorProfilePath}}">{{this.author.username}}</a></p>
                <p class="date">{{formatDate this.createdAt}}</p>
              </div>
            </div>

            <div class="review-message">
              <h4>{{this.title}}</h4>
              <p class="rating">Rating: {{this.rating}}/5</p>
              <p class="msg">{{this.body}}</p>

              {{#if this.ownerResponse.body}}
                <div class="owner-response-box">
                  <p class="owner-response-label">Owner response</p>
                  <p class="msg">{{this.ownerResponse.body}}</p>
                  <p class="date">{{formatDate this.ownerResponse.updatedAt}}</p>
                </div>
              {{/if}}
            </div>

            {{!-- Single or multiple images --}}
            {{#if this.images}}
              <div class="review-media images">
                {{#each this.images}}
                  <div class="media-frame">
                    <img class="review-image" src="/{{this}}" alt="Review image">
                  </div>
                {{/each}}
              </div>
            {{/if}}

            {{!-- Single video (or videos array) --}}
            {{#if this.videos}}
              <div class="review-media videos">
                {{#each this.videos}}
                  <div class="media-frame">
                    <video class="review-video" controls preload="metadata">
                      <source src="/{{this}}" type="video/mp4">
                      Your browser does not support the video tag.
                    </video>
                  </div>
                {{/each}}
              </div>
            {{/if}}

            <div class="review-helpful">
              <form class="vote-form" method="POST" action="/reviews/{{this._id}}/vote">
                <input type="hidden" name="direction" value="up">
                <button
                  type="submit"
                  class="helpful-btn {{#if this.isUpvoted}}voted-up{{/if}} {{#if this.isDownvoted}}muted{{/if}}"
                >
                  Upvote
                </button>
              </form>
              <form class="vote-form" method="POST" action="/reviews/{{this._id}}/vote">
                <input type="hidden" name="direction" value="down">
                <button
                  type="submit"
                  class="unhelpful-btn {{#if this.isDownvoted}}voted-down{{/if}} {{#if this.isUpvoted}}muted{{/if}}"
                >
                  Downvote
                </button>
              </form>
              <span>Score: {{this.voteScore}}</span>
            </div>

            {{#if ../isOwnerForRestaurant}}
              <div class="owner-response-form-box">
                <form class="review-manage-form" method="POST" action="/reviews/{{this._id}}/respond">
                  <div class="form-group">
                    <label for="owner-response-{{this._id}}">Public owner response</label>
                    <textarea id="owner-response-{{this._id}}" name="responseBody" rows="3" required>{{this.ownerResponse.body}}</textarea>
                  </div>
                  <button type="submit" class="login-button">{{#if this.ownerResponse.body}}Update Response{{else}}Publish Response{{/if}}</button>
                </form>
              </div>
            {{/if}}
          </article>
        {{/each}}
      {{else}}
        <p class="utility-copy">No reviews yet. Be the first to leave one.</p>
      {{/if}}
    </section>
  </section>
</main>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const inputImages = document.getElementById("inputImages");
  const inputVideo = document.getElementById("inputVideo");
  const previewFiles = document.querySelector(".media-files");
  const mediaHelp = document.querySelector(".media-help");

  function clearPreview() {
    previewFiles.innerHTML = "";
  }

  function showImagePreviews(files) {
    clearPreview();
    const max = 3;
    const list = Array.from(files).slice(0, max);
    list.forEach(file => {
      const url = URL.createObjectURL(file);
      const img = document.createElement("img");
      img.src = url;
      img.className = "media-thumb";
      img.alt = file.name;
      previewFiles.appendChild(img);
      // revoke object URL after image loads
      img.onload = () => URL.revokeObjectURL(url);
    });
    if (files.length > max) {
      const more = document.createElement("div");
      more.className = "media-file-pill";
      more.textContent = `+${files.length - max} more`;
      previewFiles.appendChild(more);
    }
    mediaHelp.textContent = "Images selected (max 3). Video will be cleared.";
  }

  function showVideoPreview(file) {
    clearPreview();
    const pill = document.createElement("div");
    pill.className = "media-file-pill";
    pill.textContent = file.name;
    previewFiles.appendChild(pill);
    mediaHelp.textContent = "Video selected. Images will be cleared.";
  }

  inputImages.addEventListener("change", (e) => {
    const files = e.target.files;
    if (!files || files.length === 0) {
      clearPreview();
      mediaHelp.textContent = "Optional: attach images or a video";
      return;
    }
    // clear video input if any
    if (inputVideo.value) {
      inputVideo.value = "";
    }
    showImagePreviews(files);
  });

  inputVideo.addEventListener("change", (e) => {
    const files = e.target.files;
    if (!files || files.length === 0) {
      clearPreview();
      mediaHelp.textContent = "Optional: attach images or a video";
      return;
    }
    // clear images input if any
    if (inputImages.value) {
      inputImages.value = "";
    }
    showVideoPreview(files[0]);
  });

  // optional: prevent selecting more than 3 images at the OS picker level is not possible,
  // but we can warn on submit. Add a submit guard:
  const form = document.querySelector(".review-post-form");
  form.addEventListener("submit", (e) => {
    if (inputImages.files && inputImages.files.length > 3) {
      e.preventDefault();
      alert("Please select up to 3 images.");
      return false;
    }
    // allow submit; server will handle file limits as well
  });
});
</script>
