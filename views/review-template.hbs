<main>
  <section class="top-hero">
    <div class="page-container hero-row">
      <div class="hero-text">
        <h1>{{restaurant.name}}</h1>
        <p class="sub">{{restaurant.location}} • {{restaurant.priceRange}} • {{restaurant.reviewCount}} reviews</p>
      </div>
      <div class="hero-image">
        <div class="image-placeholder">Leave a review and help other Lasallians decide where to eat.</div>
      </div>
    </div>
  </section>

  <section class="restaurant-header">
    <div class="restaurant-logo">
      <img src="{{restaurant.imageSrc}}" alt="{{restaurant.name}}">
    </div>
    <div class="card-body restaurant-details">
      <h3 class="title">{{restaurant.name}}</h3>
      <p class="meta">
        {{restaurant.location}} <br>
        {{restaurant.priceRange}} • ★ {{restaurant.rating}}
      </p>
      <div class="cuisine-list">
        {{#each restaurant.cuisineTypes}}
          <span class="cuisine-btn">{{this}}</span>
        {{/each}}
      </div>
      <p class="excerpt">{{restaurant.previewDescription}}</p>
    </div>
  </section>

  {{#if currentUser}}
    <section class="login-container">
      <h1>Add a Review</h1>
      <form method="POST" action="/reviews">
        <input type="hidden" name="restaurantId" value="{{restaurant.restaurantId}}">
        <div class="form-group">
          <label for="reviewTitle">Title</label>
          <input id="reviewTitle" name="title" type="text" required />
        </div>
        <div class="form-group">
          <label for="reviewRating">Rating</label>
          <select id="reviewRating" name="rating" required>
            <option value="5">5</option>
            <option value="4">4</option>
            <option value="3">3</option>
            <option value="2">2</option>
            <option value="1">1</option>
          </select>
        </div>
        <div class="form-group">
          <label for="reviewBody">Review</label>
          <textarea id="reviewBody" name="body" rows="4" required></textarea>
        </div>
        <button type="submit" class="register-button">Post Review</button>
      </form>
    </section>
  {{else}}
    <div class="add-review-container">
      <a class="add-review-btn" href="/login">Login to add a review</a>
    </div>
  {{/if}}

  <section class="reviews-section page-container">
    <h2>Reviews</h2>
    {{#if hasReviews}}
      {{#each reviews}}
        <article class="review-card">
          <div class="review-profile">
            <img class="profile-pic" src="{{this.author.profilePic}}" alt="{{this.author.username}} profile picture"
              onerror="this.onerror=null;this.src='/img/default_profile.png';">
            <div class="review-meta">
              <p class="username"><a class="inline-link" href="{{this.authorProfilePath}}">{{this.author.username}}</a></p>
              <p class="date">{{formatDate this.createdAt}}</p>
            </div>
          </div>

          <div class="review-message">
            <h4>{{this.title}}</h4>
            <p class="rating">Rating: {{this.rating}}/5</p>
            <p class="msg">{{this.body}}</p>
          </div>

          <div class="review-helpful">
            <span>Helpful votes: {{this.helpfulCount}}</span>
          </div>
        </article>
      {{/each}}
    {{else}}
      <p class="utility-copy">No reviews yet. Be the first to leave one.</p>
    {{/if}}
  </section>
</main>
