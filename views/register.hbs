<main>
  <div class="register-container">
    <h1>Create Account</h1>
    <form method="POST" action="/auth/register">
      <div class="form-group">
        <label for="firstName">First Name</label>
        <input type="text" id="firstName" name="firstName" value="{{formData.firstName}}" required />
      </div>
      <div class="form-group">
        <label for="lastName">Last Name</label>
        <input type="text" id="lastName" name="lastName" value="{{formData.lastName}}" required />
      </div>
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" value="{{formData.username}}" required />
      </div>
      <div class="form-group">
        <label for="registerEmail">Email</label>
        <input type="email" id="registerEmail" name="email" value="{{formData.email}}" required />
      </div>
      <div class="form-group">
        <label for="registerPassword">Password</label>
        <input type="password" id="registerPassword" name="password" required />
      </div>
      <div class="form-group">
        <label for="bio">Bio</label>
        <textarea id="bio" name="bio" rows="3">{{formData.bio}}</textarea>
      </div>
      <section class="owner-request-panel">
        <label class="checkbox-row" for="isOwnerRequest">
          <input
            type="checkbox"
            id="isOwnerRequest"
            name="isOwnerRequest"
            {{#if formData.isOwnerRequest}}checked{{/if}}
          >
          <span>I am the owner of a listed establishment.</span>
        </label>
        <p class="form-note">If checked, we will also collect your restaurant and contact details for admin approval.</p>

        <div class="form-group">
          <label for="ownerRestaurantId">Listed Restaurant</label>
          <select id="ownerRestaurantId" name="ownerRestaurantId">
            <option value="">Select a restaurant</option>
            {{#each restaurants}}
              <option
                value="{{this.restaurantId}}"
                {{#if this.isOwned}}disabled{{/if}}
                {{#if (eq ../formData.ownerRestaurantId this.restaurantId)}}selected{{/if}}
              >
                {{this.name}}{{#if this.isOwned}} (Owner already assigned){{/if}}
              </option>
            {{/each}}
          </select>
        </div>

        <div class="form-group">
          <label for="ownerContactDetails">Contact Details</label>
          <input
            type="text"
            id="ownerContactDetails"
            name="ownerContactDetails"
            value="{{formData.ownerContactDetails}}"
            placeholder="Phone number, alternate email, or both"
          />
        </div>

        <div class="form-group">
          <label for="ownerRequestMessage">Owner Request Notes</label>
          <textarea id="ownerRequestMessage" name="ownerRequestMessage" rows="3">{{formData.ownerRequestMessage}}</textarea>
        </div>
      </section>
      {{#if error}}
        <div class="error-message">{{error}}</div>
      {{/if}}
      <button type="submit" class="register-button">Sign Up</button>
    </form>
    <div class="login-link">
      Already have an account? <a href="/login">Login here</a>
    </div>
  </div>
</main>
