<link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

<main>
  <section class="top-hero">
    <div class="page-container hero-row hero-row-single">
      <div class="hero-text">
        <h1>Discover restaurants near DLSU!</h1>
        <p class="sub">Reviews and simple guides to local dining spots.</p>

        <form class="search-form" role="search" method="GET" action="/restaurants">
          <input type="search" id="search-input" name="q" value="{{filters.q}}" placeholder="Search by name or location" />
          <button type="submit">Search</button>
        </form>
      </div>
    </div>
  </section>

  <section class="layout container">
    <aside class="filters">
      <h3>Filters</h3>
      <form method="GET" action="/restaurants">
        <input type="hidden" name="q" value="{{filters.q}}">
        <legend>Category</legend>
        <select name="cuisine" id="cuisine-filter">
          <option value="">All</option>
          {{#each cuisines}}
            <option value="{{this}}" {{#if (eq ../filters.cuisine this)}}selected{{/if}}>{{this}}</option>
          {{/each}}
        </select><br>

        <fieldset class="price-filter">
          <legend>Price</legend>
          <label><input type="checkbox" name="price" value="₱" {{#if (includes filters.prices "₱")}}checked{{/if}}><span>₱</span></label>
          <label><input type="checkbox" name="price" value="₱₱" {{#if (includes filters.prices "₱₱")}}checked{{/if}}><span>₱₱</span></label>
          <label><input type="checkbox" name="price" value="₱₱₱" {{#if (includes filters.prices "₱₱₱")}}checked{{/if}}><span>₱₱₱</span></label>
        </fieldset>

        <div class="filter-actions">
          <button type="submit" id="clear-filters">Apply Filters</button>
          <a class="filter-link-button" href="/restaurants">Reset</a>
        </div>
      </form>
    </aside>

    <section class="results">
      <h2>Restaurant Results</h2>
      {{#if hasResults}}
        <div class="cards-grid" id="cards-grid">
          {{#each restaurants}}
          <article class="card" data-restaurant='{{jsonData}}'>
            <div class="card-thumb">
              <img src="{{imageSrc}}" alt="{{name}}">
            </div>
            <div class="card-body">
              <h3 class="title">
                <a href="{{restaurantPath}}">{{name}}</a>
              </h3>
              <p class="meta">{{location}} <br>{{priceRange}} • {{rating}}</p>
              <div class="cuisine-list">
                {{#each cuisineTypes}}
                  <span class="cuisine-btn">{{this}}</span>
                {{/each}}
              </div>
              <p class="excerpt">{{previewDescription}}</p>
            </div>
          </article>
          {{/each}}
        </div>
      {{else}}
        <div class="results-empty">
          <p>No restaurants matched your search yet. Try clearing the filters and searching again.</p>
        </div>
      {{/if}}
    </section>
  </section>
</main>

<!-- Inset popup markup -->
<div id="inset-backdrop" class="inset-backdrop"></div>
<div id="restaurant-inset" class="inset">
  <button id="inset-close" class="inset-close">&times;</button>
  <div class="inset-content">
    <div id="inset-map" class="inset-map"></div>
    <div class="inset-info"></div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const grid = document.getElementById("cards-grid");
    const inset = document.getElementById("restaurant-inset");
    const insetInfo = inset.querySelector(".inset-info");
    const insetClose = document.getElementById("inset-close");
    const backdrop = document.getElementById("inset-backdrop");
    let currentMap = null;

    grid.addEventListener("click", e => {
      const card = e.target.closest(".card");
      if (!card) return;
      if (e.target.tagName.toLowerCase() === "a") return;

      const restaurant = JSON.parse(card.dataset.restaurant);

      insetInfo.innerHTML = `
        <h2>${restaurant.name}</h2>
        <p><strong>Location:</strong> ${restaurant.location}</p>
        <p><strong>Price Range:</strong> ${restaurant.priceRange}</p>
        <p><strong>Rating:</strong> ${restaurant.rating}</p>
        <p>${restaurant.previewDescription}</p><br>
        <p><strong>Top Review:</strong></p>
        <div class="top-review">Loading top review...</div>
      `;

      inset.classList.add("open");
      backdrop.style.display = "block";

      if (currentMap) { currentMap.remove(); currentMap = null; }
      currentMap = L.map("inset-map").setView([restaurant.coordinates.lat, restaurant.coordinates.lng], 17);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: "&copy; OpenStreetMap contributors"
      }).addTo(currentMap);
      L.marker([restaurant.coordinates.lat, restaurant.coordinates.lng]).addTo(currentMap);
      setTimeout(() => currentMap.invalidateSize(), 300);

      fetch(`/data/${restaurant.restaurantId}_reviews.json`)
        .then(res => res.ok ? res.json() : [])
        .then(reviews => {
          const reviewDiv = insetInfo.querySelector(".top-review");
          if (Array.isArray(reviews) && reviews.length > 0) {
            const topReview = reviews.reduce((best, current) =>
              current.rating > (best?.rating || 0) ? current : best, null);
            const truncated = topReview.reviewMessage.length > 120
              ? topReview.reviewMessage.slice(0, 120) + "..."
              : topReview.reviewMessage;
            reviewDiv.textContent = `"${truncated}" — ${topReview.user}`;
          } else {
            reviewDiv.textContent = "No reviews yet.";
          }
        })
        .catch(() => {
          insetInfo.querySelector(".top-review").textContent = "No reviews yet.";
        });
    });

    insetClose.addEventListener("click", () => {
      inset.classList.remove("open");
      backdrop.style.display = "none";
    });
    backdrop.addEventListener("click", () => {
      inset.classList.remove("open");
      backdrop.style.display = "none";
    });
  });
</script>