<main class="page-container">
    <h1>Contact Us</h1>

    <section style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px;">
    <div>
        <h2>Phone Numbers</h2>
        <p>Primary: 0909 123 4567</p>
        <p>Support: 0908 123 4567</p>
    </div>

    <div>
        <h2>Email</h2>
        <p>Main: <a href="mailto:mainanimo@animo-eats.example">main_animo@animoeats.example</a></p>
        <p>Secondary:: <a href="mailto:secondanimo@animo-eats.example">second_animo@animoeats.example</a></p>
    </div>
    </section>

    <hr/>

    <section style="margin-top:36px;">
        <h2>Are you a restaurant owner needing an account?</h2>
        <p>Fill in here and we'll get back with you!</p>

        {{#if ownerSuccess}}
        <div class="notice">Thanks — we'll contact you about your restaurant account shortly.</div>
        {{/if}}

        <form action="/contact-owner" method="post" class="contact-form" style="max-width:700px;">
        <div class="form-grid">
            <div class="form-group">
            <label for="ownerFirstName">First name</label>
            <input id="ownerFirstName" name="firstName" required />
            </div>

            <div class="form-group">
            <label for="ownerLastName">Last name</label>
            <input id="ownerLastName" name="lastName" required />
            </div>
        </div>

        <div class="form-group">
            <label for="ownerUsername">Username</label>
            <input id="ownerUsername" name="username" required />
        </div>

        <div class="form-group">
            <label for="ownerEmail">Email</label>
            <input id="ownerEmail" name="email" type="email" required />
        </div>

        <p><b>NOTE</b>: Password will be given once request has been accepted</p>

        <div class="form-group">
            <label for="restaurantName">Restaurant name</label>
            <input id="restaurantName" name="restaurantName" required />
        </div>

        <p class="sub">We'll contact you via email after reviewing your request.</p>
        
        <button type="submit" class="register-button">Request Account</button>
        </form>


    </section>
</main>