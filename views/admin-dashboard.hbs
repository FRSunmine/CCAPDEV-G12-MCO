<main>
  <section class="top-hero">
    <div class="page-container hero-row hero-row-single">
      <div class="hero-text">
        <h1>Admin Dashboard</h1>
        <p class="sub">Review owner requests, inspect users, and manage restaurant ownership in one place.</p>
      </div>
    </div>
  </section>

  <section class="page-container admin-shell">
    {{#if successMessage}}
      <div class="success-box">{{successMessage}}</div>
    {{/if}}

    {{#if errorMessage}}
      <div class="error-box">{{errorMessage}}</div>
    {{/if}}

    <section class="admin-section">
      <div class="admin-section-heading">
        <h2>Users</h2>
        <p class="utility-copy">Overview of every account, including role, pending requests, and assigned restaurants.</p>
      </div>
      <div class="admin-grid">
        {{#each users}}
          <article class="admin-card">
            <div class="admin-card-head">
              <h3><a class="inline-link" href="{{this.profilePath}}">{{this.username}}</a></h3>
              <span class="status-chip status-{{this.role}}">{{this.role}}</span>
            </div>
            <p class="meta">{{this.email}}</p>
            <p class="meta">Pending owner requests: {{this.pendingRequestCount}}</p>
            {{#if this.ownedRestaurants}}
              <div class="owner-restaurant-list">
                {{#each this.ownedRestaurants}}
                  <a class="owner-restaurant-link" href="/restaurants/{{this.restaurantId}}">{{this.name}}</a>
                {{/each}}
              </div>
            {{else}}
              <p class="utility-copy">No restaurants assigned.</p>
            {{/if}}
          </article>
        {{/each}}
      </div>
    </section>

    <section class="admin-section">
      <div class="admin-section-heading">
        <h2>Owner Requests</h2>
        <p class="utility-copy">Approve or reject pending owner requests and review past decisions.</p>
      </div>
      <div class="admin-grid">
        {{#each ownerRequests}}
          <article class="admin-card">
            <div class="admin-card-head">
              <h3><a class="inline-link" href="{{this.restaurantPath}}">{{this.restaurant.name}}</a></h3>
              <span class="status-chip status-{{this.status}}">{{this.status}}</span>
            </div>
            <p><strong>User:</strong> <a class="inline-link" href="{{this.profilePath}}">{{this.user.username}}</a></p>
            <p><strong>Contact:</strong> {{this.contactDetails}}</p>
            {{#if this.message}}
              <p><strong>Notes:</strong> {{this.message}}</p>
            {{/if}}
            <p class="meta">Submitted {{formatDate this.createdAt}}</p>
            {{#if (eq this.status "pending")}}
              <div class="admin-actions">
                <form method="POST" action="/admin/owner-requests/{{this._id}}/approve">
                  <button type="submit" class="register-button compact-button">Approve</button>
                </form>
                <form method="POST" action="/admin/owner-requests/{{this._id}}/reject">
                  <button type="submit" class="review-delete-button compact-button">Reject</button>
                </form>
              </div>
            {{else}}
              <p class="utility-copy">
                Reviewed
                {{#if this.reviewedBy}}by {{this.reviewedBy.username}}{{/if}}
                {{#if this.reviewedAt}}on {{formatDate this.reviewedAt}}{{/if}}.
              </p>
            {{/if}}
          </article>
        {{/each}}
      </div>
    </section>

    <section class="admin-section">
      <div class="admin-section-heading">
        <h2>Ownership</h2>
        <p class="utility-copy">Assign owners to unclaimed restaurants or remove the current owner.</p>
      </div>

      <section class="review-form-card admin-assign-card">
        <h3>Manual Assign Owner</h3>
        <form class="admin-inline-form" method="POST" action="/admin/ownership/assign">
          <div class="form-group">
            <label for="assignRestaurantId">Restaurant</label>
            <select id="assignRestaurantId" name="restaurantId" required>
              <option value="">Choose a restaurant</option>
              {{#each unownedRestaurants}}
                <option value="{{this.restaurantId}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-group">
            <label for="assignUserId">User</label>
            <select id="assignUserId" name="userId" required>
              <option value="">Choose a user</option>
              {{#each eligibleUsers}}
                <option value="{{this._id}}">{{this.username}} ({{this.role}})</option>
              {{/each}}
            </select>
          </div>
          <button type="submit" class="register-button">Assign Owner</button>
        </form>
      </section>

      <div class="admin-grid">
        {{#each restaurants}}
          <article class="admin-card">
            <div class="admin-card-head">
              <h3><a class="inline-link" href="/restaurants/{{this.restaurantId}}">{{this.name}}</a></h3>
              {{#if this.owner}}
                <span class="status-chip status-owner">owned</span>
              {{else}}
                <span class="status-chip status-pending">unowned</span>
              {{/if}}
            </div>
            {{#if this.owner}}
              <p><strong>Owner:</strong> <a class="inline-link" href="/profile/{{this.owner.username}}">{{this.owner.username}}</a></p>
              <form method="POST" action="/admin/ownership/{{this.restaurantId}}/remove">
                <button type="submit" class="review-delete-button compact-button">Remove Owner</button>
              </form>
            {{else}}
              <p class="utility-copy">No owner assigned yet. Use the form above to attach one.</p>
            {{/if}}
          </article>
        {{/each}}
      </div>
    </section>
  </section>
</main>
